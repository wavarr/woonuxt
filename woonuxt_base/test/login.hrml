<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - ModaPrime USA</title>
    <link rel="stylesheet" href="./css/style.css">
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="nav-left">
                <a href="index.html" class="brand-logo">ModaPrime USA</a>
                <a href="index.html">Shop</a>
                <a href="contact.html">Contact Us</a>
            </div>
            <div class="nav-right">
                 <button id="darkModeToggle">🌙</button>
                <!-- No login button needed on login page -->
            </div>
        </nav>
    </header>

    <main class="container login-container">
        <h1>Login</h1>
        <form class="login-form" action="#" method="POST"> <!-- Needs backend endpoint in 'action' -->
            <div class="form-group">
                <label for="username">Username or Email:</label>
                <input type="text" id="username" name="username" required>
            </div>
            <div class="form-group">
                <label for="password">Password:</label>
                <input type="password" id="password" name="password" required>
            </div>
            <button type="submit" class="btn">Login</button>
            <p class="signup-link">Don't have an account? <a href="#">Sign Up</a></p> <!-- Link to potential sign-up page -->
        </form>
    </main>

    <footer>
        <p>© 2025 ModaPrime USA. All rights reserved.</p>
    </footer>

     <script src="./js/script.js"></script>
</body>
</html>
